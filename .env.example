# Copy to .env and fill in real values. Never commit .env.
# Proxmox host (hostname or IP; the VIP proxmox.stdout.pt = 192.168.1.20)
PROXMOX_HOST=
# API token user (realm-qualified) and token name/secret
PROXMOX_USER=root@pam
PROXMOX_TOKEN_NAME=mcpserver
PROXMOX_TOKEN_VALUE=
PROXMOX_PORT=8006
# Enable destructive/write tools (default false = read-only)
PROXMOX_ALLOW_ELEVATED=false
# Verify the Proxmox TLS cert (self-signed by default, so false)
PROXMOX_VERIFY_TLS=false
# Optional comma-separated allowlists (empty = unrestricted)
PROXMOX_NODE_ALLOWLIST=
PROXMOX_VMID_ALLOWLIST=
# Optional bearer token for the MCP endpoint itself. Empty = unauthenticated.
MCP_AUTH_TOKEN=
